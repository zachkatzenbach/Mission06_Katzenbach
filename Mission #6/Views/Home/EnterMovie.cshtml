@model Movie
<h1>Enter a new movie:</h1>

<form method="post">

    <input type="hidden" asp-for="MovieId" />

    <label asp-for="Title">Movie Title:</label> <br />
    <input asp-for="Title" />
    <br />

    <label asp-for="Category">Category</label> <br />
    <select asp-for="Category">
        <option value="">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId" selected="@(Model.Category.CategoryId == c.CategoryId ? "selected" : null)">@c.CategoryName</option>
        }
    </select>
    <br />

    <label asp-for="Year">Year:</label> <br />
    <input asp-for="Year" />
    <br />

    <label asp-for="Director">Director</label> <br />
    <input asp-for="Director" />
    <br />

    <label asp-for="Rating">Rating:</label> <br />
    <select asp-for="Rating">
        <option value="">Select a Rating</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br />

    <label asp-for="Edited">Edited?</label> <br />
    <select asp-for="Edited">
        <option value=""></option>
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>
    <br />

    <label asp-for="LentTo">Lent to:</label> <br />
    <input asp-for="LentTo" />
    <br />

    <label asp-for="CopiedToPlex">Copied to Plex?</label>
    <select asp-for="CopiedToPlex">
        <option value=""></option>
        <option value="0">No</option>
        <option value="1">Yes</option>
    </select>
    <br />
    
    <label asp-for="Notes">Notes:</label> <br />

    <input asp-for="Notes" maxlength="25" />
    <br />
    <br />

    <button type="submit">Submit</button>

    <div asp-validation-summary="All"></div>
</form>